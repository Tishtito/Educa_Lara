APP_NAME=Educa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Origins allowed to call the API (config/cors.php): the admin PWA, its dev
# server, and the Capacitor shells (iOS capacitor://localhost, Android https://localhost).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,capacitor://localhost,https://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=educa_lara
DB_USERNAME=educa
DB_PASSWORD=educa

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Must exceed the longest job timeout on each connection (120 s / 600 s).
DB_QUEUE_RETRY_AFTER=150
DB_LONG_QUEUE_RETRY_AFTER=660
QUEUE_LONG_CONNECTION=database-long
QUEUE_STALL_MINUTES=5
# Make GET /up fail when workers are down (defaults to on in production).
QUEUE_HEALTH_ON_UP=
# Queue incidents, recoveries and failed jobs are mailed here.
OPS_ALERT_EMAIL=

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Outbound email over SMTP (docs/email.md). Development: Mailpit on 1025
# (inbox at http://localhost:8025). Production: your provider's SMTP host,
# usually port 587 with MAIL_SCHEME=null (STARTTLS) or 465 with MAIL_SCHEME=smtps.
# Check a new set-up with: php artisan mail:test you@example.com
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=codepasstech@gmail.com
MAIL_PASSWORD=xemwrarxzirnpngg
# One platform sender address on a domain with SPF/DKIM; each school's mail
# goes out as "<School> via Educa" with replies to the school's email.
MAIL_FROM_ADDRESS="no-reply@educa.test"
MAIL_FROM_NAME="${APP_NAME}"

# Links in emails (invitations, password resets).
EDUCA_ADMIN_URL=http://localhost:5173
EDUCA_PORTAL_URL=http://localhost:5174

# Sign-in sessions (docs/authentication.md). Minutes from sign-in until a
# session ends however much it is used (default 90 days), and days unused until
# it ends (default 30).
SANCTUM_EXPIRATION=129600
SESSION_IDLE_DAYS=30

# Continue with Google (docs/authentication.md). OAuth client IDs from Google
# Cloud Console; leave all empty to switch Google sign-in off.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# School subscriptions and M-Pesa (docs/billing.md). Leave MPESA_* empty to keep
# M-Pesa off; the superadmin can still record payments by hand.
BILLING_TRIAL_DAYS=30
BILLING_DEFAULT_CYCLE_MONTHS=4
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=174379
MPESA_PASSKEY=
# Public https base Safaricom calls back. Leave EMPTY in local development:
# `composer run dev` opens an ngrok tunnel and uses its URL (see NGROK_* below).
MPESA_CALLBACK_BASE_URL=
# Long random string; it is part of every webhook URL.
MPESA_WEBHOOK_SECRET=
# Optional, comma-separated: only these IPs may call the webhooks (production).
MPESA_ALLOWED_IPS=

# Local only: the ngrok tunnel `composer run dev` opens for M-Pesa callbacks
# (php artisan mpesa:tunnel). Needs ngrok installed and `ngrok config add-authtoken`.
# NGROK_DOMAIN: your free static domain from dashboard.ngrok.com (Domains), so
# the URL stays the same between restarts. NGROK_ENABLED=false turns it off.
NGROK_ENABLED=true
NGROK_DOMAIN=
NGROK_BIN=ngrok

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Legacy import (docs/legacy-import.md): local restores of the school's three
# legacy section databases, read with a SELECT-only user.
LEGACY_DB_USERNAME=educa_legacy
LEGACY_DB_PASSWORD=
LEGACY_LOWER_DATABASE=legacy_lower
LEGACY_UPPER_DATABASE=legacy_upper
LEGACY_JSS_DATABASE=legacy_jss
